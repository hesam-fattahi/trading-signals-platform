# -*- mode: ruby -*-
# vi: set ft=ruby :

VAGRANT_BOX = "ubuntu/jammy64"

CONTROL_PLANE_IP = "192.168.56.10"
WORKER_IPS       = ["192.168.56.11", "192.168.56.12"]

CONTROL_PLANE_MEMORY = 2048
CONTROL_PLANE_CPUS   = 1

WORKER1_MEMORY        = 3072
WORKER1_CPUS          = 1

WORKER2_MEMORY        = 3072
WORKER2_CPUS          = 2

Vagrant.configure("2") do |config|
  config.vm.box = VAGRANT_BOX

  config.ssh.forward_agent = true
  config.ssh.insert_key    = false

  # ---------------------------------------------------------------------------
  # Control plane
  # ---------------------------------------------------------------------------
  config.vm.define "control-plane" do |cp|
    cp.vm.hostname = "control-plane"
    cp.vm.network "private_network", type: "static", ip: CONTROL_PLANE_IP

    cp.vm.provider "virtualbox" do |vb|
      vb.name   = "control-plane"
      vb.memory = CONTROL_PLANE_MEMORY
      vb.cpus   = CONTROL_PLANE_CPUS
      vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
    end
  end

  # ---------------------------------------------------------------------------
  # Workers
  # ---------------------------------------------------------------------------
    config.vm.define "worker1" do |worker1|
      worker1.vm.hostname = "worker1"
      worker1.vm.network "private_network", type: "static", ip: WORKER_IPS[0]

      worker1.vm.provider "virtualbox" do |vb|
        vb.name   = "worker1"
        vb.memory = WORKER1_MEMORY
        vb.cpus   = WORKER1_CPUS
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
      end
    end

    config.vm.define "worker2" do |worker2|
      worker2.vm.hostname = "worker2"
      worker2.vm.network "private_network", type: "static", ip: WORKER_IPS[1]

      worker2.vm.provider "virtualbox" do |vb|
        vb.name   = "worker2"
        vb.memory = WORKER2_MEMORY
        vb.cpus   = WORKER2_CPUS
        vb.customize ["modifyvm", :id, "--nicpromisc2", "allow-all"]
      end
    end

  # ---------------------------------------------------------------------------
  # Provisioning with Ansible
  # ---------------------------------------------------------------------------
  config.vm.define "worker#{WORKER_IPS.length}" do |last|
    last.vm.provision "ansible" do |ansible|
      ansible.playbook           = "ansible/site.yaml"
      ansible.inventory_path     = "ansible/inventory.ini"
      ansible.config_file        = "ansible/ansible.cfg"
      ansible.limit              = "all"
      ansible.compatibility_mode = "2.0"
    end
  end
end
