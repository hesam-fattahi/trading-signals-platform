apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: piksel
spec:
  serviceSelector:
    matchLabels:
      app.kubernetes.io/part-of: piksel

  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: DoesNotExist

  interfaces:
    - "^enp0s8$"

  externalIPs: false
  loadBalancerIPs: true
---
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: piksel-gateway
spec:
  serviceSelector:
    matchLabels:
      io.cilium.gateway/owning-gateway: piksel-gateway

  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: DoesNotExist

  interfaces:
    - "^enp0s8$"

  externalIPs: false
  loadBalancerIPs: true