apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: trading
spec:
  serviceSelector:
    matchLabels:
      app.kubernetes.io/part-of: trading

  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: DoesNotExist

  interfaces:
    - "^enp0s8$"

  externalIPs: false
  loadBalancerIPs: true
---
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: trading-gateway
spec:
  serviceSelector:
    matchLabels:
      io.cilium.gateway/owning-gateway: trading-gateway

  nodeSelector:
    matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: DoesNotExist

  interfaces:
    - "^enp0s8$"

  externalIPs: false
  loadBalancerIPs: true